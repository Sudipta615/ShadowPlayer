<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>ShadowPlayer</string>
    <key>CFBundleExecutable</key>
    <string>shadowplayer</string>
    <key>CFBundleIdentifier</key>
    <string>org.shadowplayer.ShadowPlayer</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>ShadowPlayer</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.20.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <!-- A normal foreground app. LSUIElement = true would remove the Dock
         icon and make the Now Playing controls harder to reach. -->
    <key>LSUIElement</key>
    <false/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>CFBundleIconFile</key>
    <string>icon.icns</string>
    <!-- Room-correction measurement records a sweep from the user's chosen
         input. The picker appears only when the measurement wizard asks the
         system for microphone access; playback and library scans never do. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>ShadowPlayer records a short measurement sweep to calibrate room correction.</string>
</dict>
</plist>
